generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  STUDENT
  YEAR_ADMIN
}

enum UERoleType {
  UE_MANAGER
}

enum DocumentCategory {
  OFFICIAL_COURSE
  STUDENT_NOTE
}

enum ChannelType {
  GENERAL
  UE_CHANNEL
  GROUP
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String
  passwordHash        String
  globalRole          GlobalRole @default(STUDENT)
  classLevel          String   @default("VET2")
  isApproved          Boolean  @default(true)
  revisionEnabled     Boolean  @default(true)
  currentStreak       Int      @default(0)
  bestStreak          Int      @default(0)
  lastRevisionDate    String?
  totalRevisionPoints Int      @default(0)
  createdAt           DateTime @default(now())

  ueRoles          UERole[]
  documents        Document[]
  upvotes          DocumentUpvote[]
  messages         Message[]
  whiteboards      Whiteboard[]
  revisionSessions DailyRevisionSession[]
  studyArtifacts   StudyArtifact[]
  communityQuizzes CommunityQuiz[]
  quizUpvotes      CommunityQuizUpvote[]
}

model DailyRevisionSession {
  id             String    @id @default(cuid())
  userId         String
  dateKey        String
  questionsJson  String
  answersJson    String    @default("{}")
  score          Int       @default(0)
  totalQuestions Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, createdAt])
}

model UE {
  id          String       @id @default(cuid())
  code        String       @unique
  title       String
  description String
  semester    String
  classLevel  String       @default("VET2")
  examType    String       @default("PARTIEL")
  examDate    String?
  coeff       Int          @default(4)
  accentColor String       @default("#D99B26")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  roles            UERole[]
  chapters         Chapter[]
  channels         Channel[]
  whiteboards      Whiteboard[]
  studyArtifacts   StudyArtifact[]
  communityQuizzes CommunityQuiz[]
}

model UERole {
  id     String     @id @default(cuid())
  userId String
  ueId   String
  role   UERoleType @default(UE_MANAGER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ue   UE   @relation(fields: [ueId], references: [id], onDelete: Cascade)

  @@unique([userId, ueId])
}

model Chapter {
  id       String  @id @default(cuid())
  ueId     String
  title    String
  theme    String  @default("")
  parentId String?
  order    Int     @default(0)

  ue        UE         @relation(fields: [ueId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Document {
  id         String           @id @default(cuid())
  chapterId  String
  authorId   String
  title      String
  fileName   String
  localPath  String
  mimeType   String           @default("application/pdf")
  fileSize   Int              @default(0)
  category   DocumentCategory @default(STUDENT_NOTE)
  isPinned   Boolean          @default(false)
  isIndexed  Boolean          @default(false)
  pageCount  Int              @default(1)
  createdAt  DateTime         @default(now())

  chapter Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upvotes DocumentUpvote[]
  chunks  DocumentChunk[]
}

model DocumentUpvote {
  userId     String
  documentId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  content    String
  pageNumber Int                         @default(1)
  embedding  Unsupported("vector(768)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Channel {
  id   String      @id @default(cuid())
  name String      @unique
  type ChannelType @default(GENERAL)
  ueId String?

  ue       UE?       @relation(fields: [ueId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  channelId      String
  authorId       String
  content        String
  attachmentJson String?
  createdAt      DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Whiteboard {
  id           String   @id @default(cuid())
  ueId         String?
  title        String
  creatorId    String
  isPublic     Boolean  @default(false)
  isIntegrated Boolean  @default(false)
  snapshotData String   @default("{}")
  updatedAt    DateTime @updatedAt

  ue      UE?  @relation(fields: [ueId], references: [id], onDelete: SetNull)
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model StudyArtifact {
  id          String   @id @default(cuid())
  userId      String
  ueId        String?
  documentId  String?
  kind        String
  title       String
  prompt      String?
  contentJson String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ue   UE?  @relation(fields: [ueId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ueId, createdAt])
}

model CommunityQuiz {
  id            String   @id @default(cuid())
  authorId      String
  ueId          String?
  title         String
  description   String   @default("")
  questionsJson String
  isPublic      Boolean  @default(true)
  isPinned      Boolean  @default(false)
  attemptsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author  User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ue      UE?                   @relation(fields: [ueId], references: [id], onDelete: SetNull)
  upvotes CommunityQuizUpvote[]

  @@index([ueId, createdAt])
  @@index([authorId, createdAt])
}

model CommunityQuizUpvote {
  userId String
  quizId String

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz CommunityQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([userId, quizId])
}

model PdfPageNote {
  id             String   @id @default(cuid())
  userId         String
  documentId     String
  pageNumber     Int
  isBookmarked   Boolean  @default(false)
  noteText       String   @default("")
  highlightsJson String   @default("[]")
  updatedAt      DateTime @default(now())

  @@unique([userId, documentId, pageNumber])
}

model ErrorBookItem {
  id             String   @id @default(cuid())
  userId         String
  fingerprint    String
  ueId           String
  ueCode         String
  chapterId      String   @default("")
  chapterTitle   String
  questionJson   String
  wrongCount     Int      @default(1)
  srsBox         Int      @default(1)
  mastered       Boolean  @default(false)
  nextReviewDate String
  lastMissedAt   DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, mastered])
}

model MockExamSession {
  id                   String    @id @default(cuid())
  userId               String
  ueId                 String
  durationMinutes      Int
  questionsJson        String
  answersJson          String    @default("{}")
  score                Int       @default(0)
  totalQuestions       Int       @default(0)
  grade20              Float     @default(0)
  chapterBreakdownJson String    @default("[]")
  completed            Boolean   @default(false)
  startedAt            DateTime  @default(now())
  completedAt          DateTime?

  @@index([userId, ueId])
}
